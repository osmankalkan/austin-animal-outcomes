# Austin Open Data (Socrata SODA API) Configuration
# Optional: Socrata App Token to avoid strict anonymous rate limits (header: X-App-Token)
AUSTIN_APP_TOKEN=your_socrata_app_token_here

# API Endpoints
INTAKES_API_URL=https://data.austintexas.gov/resource/pyqf-r2dc.json
OUTCOMES_API_URL=https://data.austintexas.gov/resource/gsvs-ypi7.json

# Ingestion Configuration
PAGE_LIMIT=1000
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=5
RAW_DATA_DIR=data/raw
